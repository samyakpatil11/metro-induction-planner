# Local development defaults. Never store real credentials in this file.
APP_ENV=development
METRO_DEMO_MODE=true
# Optional path to a local SQLite file:
# METRO_DB=backend/data/metro.db

# Hosted production requires these values to be set in the host's secret manager.
# Do not uncomment sample values or commit a populated .env file.
# APP_ENV=production
# METRO_SECRET=
# DATABASE_URL=postgresql://user:password@host/database
# METRO_ADMIN_USERNAME=
# METRO_ADMIN_PASSWORD=  # at least 14 characters
# METRO_ADMIN_NAME=Depot Administrator
